<%- include('partials-head', {title: mode==='login'?'MOVYQORA — Sign In':'MOVYQORA — Sign Up'}) %>
<div class="auth-wrap"><div class="auth-card"><a class="brand center" href="/"><span class="playmark">▷</span><span>MOVY<span>QORA</span></span></a><h1><%=mode==='login'?'Welcome back':'Create your account'%></h1><p><%=mode==='login'?'Sign in to enter your cinematic zone.':'Sign up to watch, stream, like and comment.'%></p><% if(flash){%><div class="flash <%=flash.type%>"><%=flash.message%></div><%}%><form method="post" action="<%=mode==='login'?'/login':'/signup'%>"><%if(mode==='signup'){%><label>Name<input name="name" required></label><%}%><label>Email<input type="email" name="email" required></label><label>Password<input type="password" name="password" minlength="6" required></label><button class="btn gold full"><%=mode==='login'?'Sign In':'Sign Up'%></button></form><div class="switch"><%=mode==='login'?'New here?':'Already have an account?'%> <a href="<%=mode==='login'?'/signup':'/login'%>"><%=mode==='login'?'Sign Up':'Sign In'%></a></div></div></div></body></html>
