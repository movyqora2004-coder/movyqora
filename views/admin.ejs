<%- include('partials-head', {title:'MOVYQORA — Admin'}) %><%- include('partials-nav', {user}) %><main class="page"><div class="page-title"><span class="pill gold">ADMIN ONLY</span><h1>Control Center</h1><p>Manage content, uploaders and platform analytics.</p></div><%if(flash){%><div class="flash <%=flash.type%>"><%=flash.message%></div><%}%><div class="stats"><div><b><%=stats.total_views%></b><span>Total Views</span></div><div><b><%=stats.total_likes%></b><span>Total Likes</span></div><div><b><%=stats.total_comments%></b><span>Comments</span></div><div><b><%=stats.total_titles%></b><span>Total Content</span></div><div><b><%=stats.movies%></b><span>Movies</span></div><div><b><%=stats.series%></b><span>Web Series</span></div><div><b><%=stats.anime%></b><span>Anime</span></div></div><section class="admin-section"><h2>Users & Uploaders</h2><div class="table-wrap"><table><thead><tr><th>Name</th><th>Email</th><th>Joined</th><th>Role</th><th>Action</th></tr></thead><tbody><%users.forEach(u=>{%><tr><td><%=u.name%></td><td><%=u.email%></td><td><%=new Date(u.created_at).toLocaleDateString()%></td><td><span class="role"><%=u.role%></span></td><td><%if(u.role!=='admin'){%><form method="post" action="/admin/users/<%=u.id%>/role"><select name="role"><option value="user" <%=u.role==='user'?'selected':''%>>User</option><option value="uploader" <%=u.role==='uploader'?'selected':''%>>Uploader</option></select><button class="btn small">Save</button></form><%}else{%>Protected Admin<%}%></td></tr><%})%></tbody></table></div></section><section class="admin-section"><h2>Content Management</h2><div class="table-wrap"><table><thead><tr><th>Title</th><th>Type</th><th>Genre</th><th>Uploader</th><th>Views</th><th>Likes</th><th>Comments</th><th>Delete</th></tr></thead><tbody><%titles.forEach(t=>{%><tr><td><%=t.title%></td><td><%=t.type%></td><td><%=t.genre%></td><td><%=t.uploader||'—'%></td><td><%=t.views%></td><td><%=t.likes%></td><td><%=t.comments%></td><td><form method="post" action="/admin/titles/<%=t.id%>/delete" onsubmit="return confirm('Delete this content?')"><button class="btn danger small">Delete</button></form></td></tr><%})%></tbody></table></div></section></main></body></html>
